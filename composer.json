{
    "name": "methorz/jwt-auth-middleware",
    "description": "PSR-15 JWT authentication middleware with zero-config approach. Supports HS256/RS256, Bearer/custom headers, optional user loading, and scope validation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "lcobucci/clock": "^3.2",
        "lcobucci/jwt": "^5.4",
        "psr/clock": "^1.0",
        "psr/container": "^1.1|^2.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "laminas/laminas-diactoros": "^3.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "slevomat/coding-standard": "^8.25",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MethorZ\\JwtAuthMiddleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MethorZ\\JwtAuthMiddleware\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@analyze",
            "@test"
        ],
        "analyze": "phpstan analyze --memory-limit=512M",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-html coverage/"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

